[Unit]
Description=edge-sync kernel daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/edge-sync
ExecStart=/opt/edge-sync/bin/edge-syncd -config /opt/edge-sync/etc/config.yaml
Restart=always
RestartSec=5
MemoryMax=64M
Nice=5

[Install]
WantedBy=multi-user.target
