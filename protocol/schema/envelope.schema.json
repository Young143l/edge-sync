{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "envelope.schema.json",
  "title": "edge-sync plugin protocol - JSON-RPC 2.0 envelope (line-delimited)",
  "description": "内核 spawn 插件进程，stdin/stdout 每行一个完整 JSON 消息。stdout 仅协议消息，日志走 stderr。",
  "definitions": {
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer", "minimum": 0 },
        "method": { "enum": ["initialize", "snapshot", "fetchFile"] },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/definitions/errorCodes" },
        "message": { "type": "string", "minLength": 1 },
        "data": {}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer", "minimum": 0 },
        "result": {},
        "error": { "$ref": "#/definitions/error" }
      },
      "additionalProperties": false
    },
    "errorCodes": {
      "type": "integer",
      "description": "-32700 parse / -32600 invalid request / -32601 method not found / -32602 invalid params / -32603 internal / -32000 source unreachable / -32001 auth failed / -32002 not found",
      "enum": [-32700, -32600, -32601, -32602, -32603, -32000, -32001, -32002]
    }
  }
}
